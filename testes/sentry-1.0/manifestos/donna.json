  "privacy_policy": {
    "schema_version": 1,
    "policy_id": "rascunho-donna-compativel-referencia-v1",
    "rules": [
      {
        "rule_id": "escopo-da-tarefa",
        "tools": [
          "descrever_donna",
          "buscar_emails",
          "ler_email",
          "ler_anexo_email",
          "status_seguranca",
          "consultar_agenda",
          "encontrar_horarios_livres",
